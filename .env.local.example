# =============================================================================
# Fethr Health — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URI=

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analytics (all optional — feature-flag with env check before calling APIs)
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag partner ID
NEXT_PUBLIC_LINKEDIN_ID=

# ---------------------------------------------------------------------------
# Email — Microsoft Graph API (Azure AD)
# Required for Payload password reset and any transactional email.
# ---------------------------------------------------------------------------
# Directory (tenant) ID — Azure AD → App registrations → your app → Overview
AZURE_TENANT_ID=
# Application (client) ID — same Overview page
AZURE_CLIENT_ID=
# Client secret value — Azure AD → App registrations → your app → Certificates & secrets
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Vercel Blob (media uploads via Payload CMS)
# ---------------------------------------------------------------------------
# Automatically injected by Vercel when you add a Blob store to the project.
# For local dev: copy from Vercel dashboard → Storage → your blob store → .env.local
BLOB_READ_WRITE_TOKEN=
